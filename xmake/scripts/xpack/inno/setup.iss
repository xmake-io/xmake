; this is an Inno Setup script,
; it is autogenerated by the xmake build system.
; do not edit by hand.

[Setup]
AppId={{${PACKAGE_INNO_APPID}}
AppName=${PACKAGE_TITLE}
AppVersion=${PACKAGE_VERSION}
AppVerName=${PACKAGE_TITLE} ${PACKAGE_VERSION}
AppPublisher=${PACKAGE_COMPANY}
AppPublisherURL=${PACKAGE_HOMEPAGE}
AppSupportURL=${PACKAGE_HOMEPAGE}
AppUpdatesURL=${PACKAGE_HOMEPAGE}
DefaultDirName={autopf}\${PACKAGE_NAME}
OutputDir=${PACKAGE_OUTPUTDIR}
OutputBaseFilename=${PACKAGE_BASENAME}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=admin
PrivilegesRequiredOverridesAllowed=commandline
${PACKAGE_INNO_ARCH}
VersionInfoVersion=${PACKAGE_VERSION_MAJOR}.${PACKAGE_VERSION_MINOR}.${PACKAGE_VERSION_ALTER}.0
SetupIconFile=${PACKAGE_ICONFILE}
LicenseFile=${PACKAGE_LICENSEFILE}
UninstallDisplayIcon=${PACKAGE_DISPLAYICON}
UninstallDisplayName=${PACKAGE_TITLE}

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "addpath"; Description: "Add to PATH"; GroupDescription: "Additional:"; Flags: checkedonce

[Components]
${PACKAGE_INNO_COMPONENTS}

[Files]
${PACKAGE_INNO_FILES}

[Dirs]
${PACKAGE_INNO_DIRS}

[Registry]
Root: HKLM; Subkey: "SYSTEM\CurrentControlSet\Control\Session Manager\Environment"; ValueType: expandsz; ValueName: "Path"; ValueData: "{olddata};${PACKAGE_BINDIR}"; Tasks: addpath; Check: NeedsAddPath(ExpandConstant('${PACKAGE_BINDIR}')) and IsAdminInstallMode
Root: HKCU; Subkey: "Environment"; ValueType: expandsz; ValueName: "Path"; ValueData: "{olddata};${PACKAGE_BINDIR}"; Tasks: addpath; Check: NeedsAddPath(ExpandConstant('${PACKAGE_BINDIR}')) and (not IsAdminInstallMode)
${PACKAGE_INNO_REGISTRY}

[Run]
${PACKAGE_INNO_RUN}

[InstallDelete]
${PACKAGE_INNO_INSTALLDELETE}

[UninstallDelete]
${PACKAGE_INNO_UNINSTALLDELETE}

${PACKAGE_INNO_RAW}

[Code]
function NeedsAddPath(Param: string): boolean;
var
  OrigPath: string;
  RootKey: Integer;
begin
  if IsAdminInstallMode then
    RootKey := HKEY_LOCAL_MACHINE
  else
    RootKey := HKEY_CURRENT_USER;
  if not RegQueryStringValue(RootKey, 'Environment', 'Path', OrigPath) then
  begin
    if not RegQueryStringValue(RootKey, 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment', 'Path', OrigPath) then
    begin
      Result := True;
      exit;
    end;
  end;
  Result := Pos(';' + Uppercase(Param) + ';', ';' + Uppercase(OrigPath) + ';') = 0;
end;

procedure RemoveFromPath(Param: string);
var
  OrigPath: string;
  RootKey: Integer;
begin
  if IsAdminInstallMode then
    RootKey := HKEY_LOCAL_MACHINE
  else
    RootKey := HKEY_CURRENT_USER;
  if not RegQueryStringValue(RootKey, 'Environment', 'Path', OrigPath) then
    RegQueryStringValue(RootKey, 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment', 'Path', OrigPath);
  if StringChangeEx(OrigPath, ';' + Param, '', True) > 0 then
    if IsAdminInstallMode then
      RegWriteExpandStringValue(HKEY_LOCAL_MACHINE, 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment', 'Path', OrigPath)
    else
      RegWriteExpandStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', OrigPath);
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
${PACKAGE_INNO_CODE}
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
    RemoveFromPath(ExpandConstant('${PACKAGE_BINDIR}'));
end;
